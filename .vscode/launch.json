{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Debug FastAPI in Docker",
      "type": "debugpy",
      "request": "attach",
      "connect": {
        "host": "localhost",
        "port": 5678
      },
      "cwd": "${workspaceFolder}",
      "pathMappings": [
        {
          "localRoot": "${workspaceFolder}",
          "remoteRoot": "/app"
        }
      ],
      "jinja": true,
      "justMyCode": true,
      "preLaunchTask": "Start Debug Stack"
    }
  ]
}